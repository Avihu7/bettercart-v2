# Optional: Add your Anthropic API key to enable real AI analysis.
# Without this, the app runs in demo mode with pre-built sample data.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Backend API URL (defaults to http://localhost:3001 if not set)
VITE_API_URL=http://localhost:3001

# Password-reset emails (server-side only — never prefix with VITE_)
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Sender. Resend's test sender only delivers to your own Resend account email
# until you verify a domain; then use e.g. BetterCart <no-reply@your-domain.com>
EMAIL_FROM=BetterCart <onboarding@resend.dev>
# Public URL of the app, used in the reset link
APP_URL=http://localhost:5173
